# Copy to .env for local development and fill in your key.
# In production this is set as a platform secret (Secret Manager on Cloud Run),
# never committed.
#
# The app runs without it: the page serves normally and the chat endpoints
# return 503 until a key is set. Get a free one at https://console.groq.com.
GROQ_API_KEY=your-groq-api-key-here

# Optional overrides (defaults live in app/config.py):
# DRAFTER_MODEL=openai/gpt-oss-120b
# JUDGE_MODEL=openai/gpt-oss-120b
# TOP_K=5
